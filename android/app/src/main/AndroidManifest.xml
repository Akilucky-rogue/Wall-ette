<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No Google backups or phone-to-phone copies of the wallet data: it comes
         back from the cloud on sign-in (audit M11). The two rules files cover
         device transfers on phones that ignore allowBackup. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share to Wall-ette: text shared from another app opens as
                 "Add this?" (MainActivity.takeShare). -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!-- Payments from your apps (from 1.6.0): reads payment and bank apps'
             notifications once the person allows notification access, and
             only those apps' (PaymentAlertListener.PACKAGES). Never
             conversations. -->
        <service
            android:name=".PaymentAlertListener"
            android:label="@string/payment_alerts_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="alerting|silent" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations|ongoing" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Crash reports: on in release builds, off in debug (app/build.gradle).
             Profile → Crash Reports overrides it on a device. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollection}" />
    </application>

    <!-- The payment and bank apps whose notifications may be read, so the
         settings screen can say which are on this phone (Android 11+ hides
         other apps otherwise). Same list as PaymentAlertListener.PACKAGES. -->
    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.snapwork.hdfc" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="com.axis.mobile" />
        <package android:name="com.kotak.bank.mobile" />
        <package android:name="com.msf.kbank.mobile" />
        <package android:name="com.idfcfirstbank.optimus" />
        <package android:name="com.infrasoft.uboi" />
        <package android:name="com.saraswatbank.retailbanking" />
        <package android:name="com.saraswat.mobilebankingv2" />
        <package android:name="com.equitas.elevate" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone notifications (@capacitor/local-notifications) are reminders a
         few minutes either way is fine for, so they use inexact alarms and the
         app doesn't ask for "Alarms & reminders" (services/phoneNotifier.ts). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
