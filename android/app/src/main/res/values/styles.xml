<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The app draws edge to edge on every Android version (audit H6;
             MainActivity calls EdgeToEdge.enable, which makes both bars
             transparent). Capacitor's SystemBars keeps the page clear of the
             bars: it passes the insets to CSS (the sat and sab variables in
             index.html), or on older WebViews pads the page, and then this
             background shows behind the bars. No statusBarColor or
             navigationBarColor here: Android 15 deprecated them. The page
             paints the theme colour behind the 3-button bar, so Android's
             contrast scrim stays off. -->
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>


    <!-- The launch screen: Wall·ette's round icon on the app's cream. Android
         12+ draws it itself; androidx's Theme.SplashScreen draws the same on
         older versions. Without these the launcher showed Android's default
         app icon there (the library's default). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>