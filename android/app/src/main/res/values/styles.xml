<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Android 15+ draws apps edge to edge, and from target SDK 36 the
             opt-out is ignored (audit H6). Capacitor's SystemBars keeps the
             page clear of the bars: it passes the insets to CSS (the sat and
             sab variables in index.html), or on older WebViews pads the
             page, and then this background shows behind the bars.
             statusBarColor and navigationBarColor apply on Android 14 and
             older only. Android 15+ would lay navigationBarColor at 80% over
             the 3-button bar, which clashes with dark themes, so that scrim
             is off and index.html paints the theme colour there instead. -->
        <item name="android:windowBackground">#FAF9F6</item>
        <item name="android:statusBarColor">#FAF9F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FAF9F6</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>