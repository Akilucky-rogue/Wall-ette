<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and earlier: the same exclusions as data_extraction_rules.xml.
    allowBackup="false" already turns backups off on these versions; this list
    keeps the wallet data out even if backups are ever turned back on.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
