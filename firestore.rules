rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== USER PROFILE ==========
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== TRANSACTIONS ==========
    match /users/{userId}/transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['INCOME', 'EXPENSE']
                    && request.resource.data.category is string
                    && request.resource.data.date is string;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['INCOME', 'EXPENSE'];
    }

    // ========== SETTINGS (preferences, ignore rules, limits, MFA) ==========
    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== SECURITY LOGS (never edited) ==========
    match /users/{userId}/security_logs/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Owners can delete their logs, so deleting the account erases them
      // (audit M3); no one can change an entry.
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // ========== APP CONFIG (read-only) ==========
    // config/app holds non-secret switches the app reads, such as
    // androidMinVersionCode: Android builds below it must update before use
    // (services/appUpdates.ts). Edited in the Firebase console only.
    match /config/app {
      allow get: if request.auth != null;
    }

    // ========== WEBSITE FORMS (wall-ette.com) ==========
    // Anyone may send a contact message or join the Monthly Check-in; no one
    // can read, change or delete them from outside (read them in the Firebase
    // console). Fields and sizes are checked here (site/src/lib/forms.ts).
    function isEmail(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    match /site_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && isEmail(request.resource.data.email)
                    && request.resource.data.topic in ['support', 'bank', 'feedback', 'privacy', 'press', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
                    && request.resource.data.createdAt == request.time;
    }
    // One document per address (its id), so subscribing twice is refused.
    match /newsletter/{address} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && isEmail(request.resource.data.email)
                    && request.resource.data.email == address
                    && request.resource.data.source is string && request.resource.data.source.size() <= 40
                    && request.resource.data.createdAt == request.time;
    }

    // ========== DENY BY DEFAULT ==========
    // Anything not explicitly matched above is rejected.
  }
}
