rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== USER PROFILE ==========
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== ENTRIES, ONE DOCUMENT PER ENTRY (up to 1.5.9) ==========
    // From 1.6.0 a wallet's entries live in month documents (below). The app
    // moves each wallet once (services/monthStore.ts): it sets
    // settings.entriesIn to 'moving', reads these documents, writes the
    // months, sets 'months' and deletes these. From 'moving' on, older
    // versions can't add or change entries here, so the move misses nothing;
    // they show "didn't save" until updated. Reading and deleting stay open
    // for the move.
    function entriesMoved(userId) {
      let prefs = /databases/$(database)/documents/users/$(userId)/settings/preferences;
      return exists(prefs) && get(prefs).data.get('entriesIn', '') in ['moving', 'months'];
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !entriesMoved(userId)
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['INCOME', 'EXPENSE']
                    && request.resource.data.category is string
                    && request.resource.data.date is string;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !entriesMoved(userId)
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['INCOME', 'EXPENSE'];
    }

    // ========== ENTRIES BY MONTH (from 1.6.0) ==========
    // users/{uid}/months/{YYYY-MM}, or YYYY-MM-2 when a month spills over:
    // one field, `entries`, a map from entry id to the entry. Rules can't
    // check a map entry by entry, so the app checks each entry before
    // writing (services/months.ts); Firestore keeps each document under
    // 1 MiB. firestore.indexes.json leaves `entries` unindexed.
    match /users/{userId}/months/{monthId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && monthId.matches('^[0-9]{4}-[0-9]{2}(-[0-9]+)?$')
                    && request.resource.data.keys().hasOnly(['entries'])
                    && (!('entries' in request.resource.data)
                        || (request.resource.data.entries is map
                            && request.resource.data.entries.size() <= 5000));
    }

    // ========== SETTINGS (preferences, ignore rules, limits, MFA) ==========
    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== SECURITY LOGS (never edited) ==========
    match /users/{userId}/security_logs/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Owners can delete their logs, so deleting the account erases them
      // (audit M3); no one can change an entry.
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // ========== APP CONFIG (read-only) ==========
    // config/app holds non-secret switches the app reads, such as
    // androidMinVersionCode: Android builds below it must update before use
    // (services/appUpdates.ts). Edited in the Firebase console only.
    match /config/app {
      allow get: if request.auth != null;
    }

    // ========== WEBSITE FORMS (wall-ette.com) ==========
    // Anyone may send a contact message or join the Monthly Check-in; no one
    // can read, change or delete them from outside (read them in the Firebase
    // console). Fields and sizes are checked here (site/src/lib/forms.ts).
    function isEmail(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    match /site_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && isEmail(request.resource.data.email)
                    && request.resource.data.topic in ['support', 'bank', 'feedback', 'privacy', 'press', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
                    && request.resource.data.createdAt == request.time;
    }
    // One document per address (its id), so subscribing twice is refused.
    match /newsletter/{address} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && isEmail(request.resource.data.email)
                    && request.resource.data.email == address
                    && request.resource.data.source is string && request.resource.data.source.size() <= 40
                    && request.resource.data.createdAt == request.time;
    }

    // ========== DENY BY DEFAULT ==========
    // Anything not explicitly matched above is rejected.
  }
}
